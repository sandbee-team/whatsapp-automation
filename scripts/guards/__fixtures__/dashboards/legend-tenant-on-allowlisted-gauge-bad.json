      "targets": [
        {
          "refId": "A",
          "expr": "wp_instance_health_state",
          "legendFormat": "{{client_id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {}
    }
  ]
