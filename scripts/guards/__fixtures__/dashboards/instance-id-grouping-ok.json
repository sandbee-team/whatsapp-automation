{
  "uid": "fixture-instance-id-ok",
  "title": "Fixture: instance_id grouping over an instance-labelled gauge",
  "tags": ["wp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Paused instances",
      "description": "Fixture panel - should NOT fail the guard (instance-labelled gauge).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (instance_id) (wp_instance_health_state == 3)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {}
    }
  ]
}
