{
  "name": "wp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ci": "tsx scripts/ci-steps.ts run",
    "lint": "eslint --config packages/config/eslint.config.js --cache --cache-location node_modules/.cache/eslint/ .",
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json --noEmit && tsc -p app/backend/tsconfig.test.json --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:int": "pnpm -F @wp/db run test && pnpm -F app-backend run test:int && pnpm -F admin-backend run test:int",
    "build": "tsc -b",
    "guards": "tsx scripts/guards/meta-assert.ts",
    "guards:meta": "tsx scripts/guards/meta-assert.ts",
    "guards:depcruise": "depcruise app admin website packages db --config .dependency-cruiser.cjs --output-type err",
    "domain:browser-build": "pnpm -F @wp/domain run build:browser",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "tokens:build": "pnpm -F @wp/design-tokens run tokens:build",
    "check:tenant-scope": "tsx scripts/check-tree.ts && tsx scripts/check-tenant-scope.ts && tsx scripts/check-sql-lint.ts && tsx scripts/check-role-boot.ts && tsx scripts/check-single-claim.ts && tsx scripts/check-no-auto-requeue.ts",
    "check:single-reserve": "tsx scripts/check-single-reserve.ts",
    "check:single-debit": "tsx scripts/check-single-debit.ts",
    "check:send-origin": "tsx scripts/check-send-origin.ts",
    "check:copy": "tsx scripts/check-copy.ts",
    "check:no-raw-hex": "tsx scripts/check-no-raw-hex.ts",
    "check:ui-client-directive": "tsx scripts/check-ui-client-directive.ts",
    "check:serialisation-boundary": "tsx scripts/check-serialisation-boundary.ts",
    "check:shutdown-purity": "tsx scripts/check-shutdown-purity.ts",
    "check:placement-neutrality": "tsx scripts/check-placement-neutrality.ts",
    "check:box-memory": "tsx scripts/check-box-memory.ts",
    "check:capacity-gate": "tsx scripts/check-capacity-gate.ts",
    "check:no-direct-publish": "tsx scripts/check-no-direct-publish.ts",
    "check:api-key-routes": "tsx scripts/check-api-key-routes.ts",
    "check:no-insecure-tls": "tsx scripts/check-no-insecure-tls.ts",
    "check:health-writers": "tsx scripts/check-health-writers.ts",
    "check:scheduler-queries": "tsx scripts/check-scheduler-queries.ts",
    "check:forbidden-mechanisms": "tsx scripts/check-forbidden-mechanisms.ts",
    "check:no-bulk-lookup": "tsx scripts/check-no-bulk-lookup.ts",
    "check:metric-inventory": "tsx scripts/check-metric-inventory.ts",
    "check:metric-manifest": "tsx scripts/gen-metric-manifest.ts --check",
    "check:dashboards": "tsx scripts/check-dashboards.ts",
    "check:alert-rules": "tsx scripts/check-alert-rules.ts",
    "check:semgrep": "tsx scripts/scan-semgrep.ts",
    "check:trivy": "tsx scripts/scan-trivy.ts",
    "check:secret-scan": "tsx scripts/scan-secrets.ts",
    "drill:keyring": "tsx infra/backup/keyring-restore-drill.ts",
    "format": "prettier --config packages/config/prettier.config.mjs --cache --write .",
    "format:check": "prettier --config packages/config/prettier.config.mjs --cache --check ."
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@wp/domain": "workspace:*",
    "@wp/i18n": "workspace:*",
    "@wp/server-kit": "workspace:*",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "fast-glob": "^3.3.3",
    "otplib": "^13.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
