# compose.env.example - copy to /opt/wp/.env (NEXT TO docker-compose.prod.yml).
#
# This is NOT the application's env file. Two files exist on the box, and
# confusing them makes `docker compose` refuse to parse:
#
#   /opt/wp/.env      <- THIS FILE. Only the values compose interpolates with
#                        ${...} while READING the yaml.
#   /etc/wp/wp.env    <- everything the application processes read at run time
#                        (infra/deploy/wp.env.example). Compose passes it
#                        through `env_file:` and never looks inside it.
#
# `env_file:` values are invisible to interpolation. That is why
# POSTGRES_PASSWORD has to be here as well as in wp.env: postgres and pgbouncer
# take it through compose, the application takes it inside DATABASE_URL.
#
#   sudo chown root:root /opt/wp/.env && sudo chmod 600 /opt/wp/.env

# The Postgres superuser password for the containerised database. Must match
# the password inside DATABASE_URL in /etc/wp/wp.env.
POSTGRES_PASSWORD=<the database password>

# Used by the one-shot `migrate` service ONLY, and it must point STRAIGHT at
# postgres, never at pgbouncer: the migration runner serialises with a
# SESSION-scoped pg_advisory_lock, which transaction pooling breaks.
# Same value as MIGRATE_DATABASE_URL in /etc/wp/wp.env.
MIGRATE_DATABASE_URL=postgres://wp:<the database password>@postgres:5432/wp

# Optional; shown with their defaults.
#POSTGRES_USER=wp
#POSTGRES_DB=wp

# Which image tag to run. ship-image.sh retags each build as :latest, so the
# default is usually right; pin an explicit tag to roll back.
#WP_IMAGE=wp-backend:latest

# Where the application env file and the key ring live on the HOST.
#WP_ENV_FILE=/etc/wp/wp.env
#WP_KEY_RING_DIR=/etc/wp/keyring

# Host ports (loopback only - the edge proxies to them).
#API_PORT=3000
#ADMIN_PORT=3001

# ===========================================================================
# Edge (Caddy) - see infra/nginx/Caddyfile and infra/nginx/README.md
# ===========================================================================
# REQUIRED. The two subdomains Caddy requests certificates for and routes to
# the app panel / admin panel. Two subdomains, not one host with paths,
# because neither SPA sets a router basepath - both assume they are served
# at `/` (see infra/nginx/Caddyfile's header comment for the full reason).
# You must point BOTH as A records at this box's public IP before Caddy can
# get a certificate for them.
APP_DOMAIN=<app.your-domain.example>
ADMIN_DOMAIN=<admin.your-domain.example>

# REQUIRED. Let's Encrypt sends certificate expiry/problem notices here; it
# is not a login and receives no other traffic.
ACME_EMAIL=<you@your-domain.example>

# Optional; shown with their defaults. Where the built SPAs live on the HOST
# (see infra/deploy/build-frontends.sh + ship-frontends.sh, which build and
# rsync app/frontend's and admin/frontend's `dist/` trees here).
#WP_APP_FRONTEND_DIR=/opt/wp/frontends/app
#WP_ADMIN_FRONTEND_DIR=/opt/wp/frontends/admin

# Where infra/nginx/Caddyfile lands on the HOST. ship-image.sh rsyncs it here
# alongside docker-compose.prod.yml on every deploy (there is no repo
# checkout on the box - ADR 0003 - so this must be an absolute path, not one
# relative to the repo's infra/compose/ and infra/nginx/ layout).
#WP_CADDYFILE=/opt/wp/Caddyfile

# Must equal WORKER_HEAP_BUDGET_MB in wp.env. The session worker refuses to
# boot if its --max-old-space-size disagrees with that budget.
#WORKER_HEAP_BUDGET_MB=3072

# PgBouncer sizing (design-doc figures; change only with a reason).
#PGBOUNCER_DEFAULT_POOL_SIZE=60
#PGBOUNCER_RESERVE_POOL_SIZE=20
#PGBOUNCER_MAX_CLIENT_CONN=4000
