# wp.env.example (2026-09-14) - the production env file for a single EC2 box.
#
# Copy to /etc/wp/wp.env on the host, fill in every <...>, then:
#   sudo chown root:root /etc/wp/wp.env && sudo chmod 600 /etc/wp/wp.env
#
# This file is NEVER committed and NEVER baked into the image. The compose file
# reads it at run time via `env_file:`.
#
# Everything marked REQUIRED has no usable default in production: the process
# refuses to start without it (fail-closed, by design). Everything else has a
# working default and is listed so you know the knob exists.

# ===========================================================================
# REQUIRED - the process will not boot without these
# ===========================================================================

# Node's own mode. Must be `production`: it is what switches off every dev
# fallback below (JWT secret, key ring) and what makes the metrics listener
# refuse an all-interfaces bind.
NODE_ENV=production

# Signs session/refresh/MFA tokens. Minimum 32 characters. Generate with:
#   openssl rand -base64 48
# Rotating it logs every user out. There is NO dev fallback in production.
AUTH_JWT_SECRET=<32+ random characters>

# Path INSIDE the container to the key ring JSON. The compose file mounts the
# host directory ${WP_KEY_RING_DIR} (default /etc/wp/keyring) at /keyring
# read-only, so this normally stays as-is.
# The ring must exist in exactly three places before launch - see
# docs/runbooks/key-ring-restore.md and LAUNCH-CHECKLIST row 23.
KEY_RING_PATH=/keyring/key-ring.json
WP_KEY_RING_PATH=/keyring/key-ring.json

# server-kit's own config block. WP_KEK_PURPOSES must list EVERY purpose the
# code uses; a purpose present here with no key material in the ring fails at
# first use, not at boot, so provision material for all of them.
WP_ENV=production
WP_LOG_LEVEL=info
WP_KEK_PURPOSES=session,tenant-secrets,user-secrets,optout-pepper,api-key-pepper
WP_ENC_VERSION=1

# Data plane. `postgres`, `redis` and `redis-sig` are the compose service
# names - do not point these at localhost.
#
# The long-running roles go through PgBouncer (transaction pooling), which is
# safe because `withTenant` uses `SET LOCAL` inside a transaction.
DATABASE_URL=postgres://wp:<POSTGRES_PASSWORD>@pgbouncer:5432/wp

# MIGRATIONS MUST BYPASS PGBOUNCER. The migration runner serialises concurrent
# runs with `pg_advisory_lock`, which is SESSION-scoped (db/src/migrate.ts:122).
# Under transaction pooling the lock can be acquired on one backend and the
# unlock issued on another, so the lock silently fails to serialise and two
# deploys could migrate at once. This URL points straight at Postgres and is
# used only by the one-shot `migrate` service.
MIGRATE_DATABASE_URL=postgres://wp:<POSTGRES_PASSWORD>@postgres:5432/wp
REDIS_URL=redis://redis:6379
REDIS_SIG_URL=redis://redis-sig:6379

# ===========================================================================
# REQUIRED for media (S3). Omit the whole block only if you keep the `fs`
# driver, which is NOT suitable for a real deployment.
# ===========================================================================
# The driver is configured MinIO-style (endpoint/port/ssl), NOT by region, and
# it uses STATIC KEYS - there is no IAM instance-profile support. Create the
# bucket BY HAND first: the driver tries makeBucket() if the bucket seems
# absent, and a correctly scoped IAM policy makes that call fail.
OBJECT_STORE_DRIVER=s3
S3_ENDPOINT=s3.<region>.amazonaws.com
S3_PORT=443
S3_USE_SSL=true
S3_ACCESS_KEY=<iam access key>
S3_SECRET_KEY=<iam secret key>
S3_BUCKET=<bucket name>

# ===========================================================================
# REQUIRED for outbound mail
# ===========================================================================
# Gmail needs an APP PASSWORD (2-Step Verification on), never the account
# password. MAIL_USER and MAIL_PASSWORD must be set TOGETHER - a half pair is
# a deliberate boot failure, because an unauthenticated relay silently refuses
# every message.
# Port 465 = implicit TLS (MAIL_SECURE=true). Port 587 = STARTTLS
# (MAIL_SECURE=false); the mailer requires TLS before sending credentials.
# Know the ceiling: consumer Gmail allows roughly 500 recipients/day.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=<sending address>
MAIL_PASSWORD=<16-character app password>
MAIL_FROM=<sending address>

# ===========================================================================
# Edge / networking
# ===========================================================================
# The public origin used to build links in outbound email. Must be the
# app.<domain> subdomain Caddy terminates TLS for (infra/nginx/Caddyfile,
# APP_DOMAIN in compose.env.example) - app/frontend is served there, not at
# the bare domain.
PUBLIC_BASE_URL=https://<app.your-domain.example>

# Set ONLY if a reverse proxy sits in front and OVERWRITES X-Forwarded-For.
# A wrong value here lets a caller spoof req.ip and defeat every IP-scoped
# rate limit. Leave false until the edge is confirmed to overwrite, not
# append. Caddy's `/v1/*` route in infra/nginx/Caddyfile uses
# `header_up X-Forwarded-For {remote_ip}`, which REPLACES the header (never
# appends) - once that Caddyfile is the box's edge, set this to true.
TRUST_PROXY=true

# /metrics stays on loopback. Production REFUSES an all-interfaces bind
# (0.0.0.0, ::, empty) and throws before the socket opens. Scrape locally.
WP_METRICS_BIND=127.0.0.1
WP_METRICS_PORT=9464

# ===========================================================================
# Admin / staff API (the `admin-api` service) - see LAUNCH-CHECKLIST row 25
# ===========================================================================
# This is a SEPARATE process from `api`, with its own config and its own auth
# (staff argon2id + mandatory TOTP + an IP allow-list). It runs from the same
# image. In production it REFUSES to boot without all five of the secrets
# below (admin/backend/src/platform/config.ts).

# 32+ chars each, and each one DISTINCT - never reuse AUTH_JWT_SECRET here.
ADMIN_JWT_SECRET=<32+ random characters>
INTERNAL_API_SERVICE_TOKEN_SECRET=<32+ random characters>
LEADS_IP_HASH_SECRET=<32+ random characters>

# Comma-separated origins allowed to POST the marketing site's leads form.
LEADS_ALLOWED_ORIGINS=https://<your domain>

# THE ADMIN PANEL IS UNREACHABLE UNTIL YOU SET THIS. The default is an empty
# string, which denies every caller - deliberately fail-closed. Put your own
# office/VPN CIDR here, never 0.0.0.0/0 on a real deployment.
ADMIN_IP_ALLOWED_CIDRS=<your.ip.address/32>

# Set true ONLY when a proxy in front OVERWRITES X-Forwarded-For. A wrong
# value lets a caller spoof their IP and walk straight through the allow-list
# above. Same Caddyfile route rationale as app-backend's TRUST_PROXY above -
# once Caddy (infra/nginx/Caddyfile's `/admin/v1/*` route) is the box's edge
# and its `header_up X-Forwarded-For {remote_ip}` is in effect, set this true.
ADMIN_TRUST_PROXY=true

# Optional: defaults to DATABASE_URL. Set it only to give the admin API its
# own (e.g. more restricted) connection.
#ADMIN_DATABASE_URL=

# The tenant-facing `api` service's own internal endpoint. Leave false unless
# the admin API is configured to call it; enabling without
# INTERNAL_API_SERVICE_TOKEN_SECRET is a boot failure.
INTERNAL_API_ENABLED=false
#INTERNAL_API_ALLOWED_CIDRS=

# ===========================================================================
# Optional - defaults shown. Change only with a reason.
# ===========================================================================
#PORT=3000

# Lowering WORKER_HEAP_BUDGET_MB directly lowers how many sessions one worker
# may hold. Do NOT lowe